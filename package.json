{
  "name": "Github Page",
  "private": true,
  "packageManager": "yarn@4.9.2",
  "scripts": {
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "build:pages": "yarn workspace portfolio build --mode pages && yarn workspace flora-studies build --mode pages && node scripts/stage-pages.mjs",
    "preview:pages": "yarn workspace portfolio exec vite preview --config ../../scripts/pages-preview.config.mjs"
  },
  "workspaces": [
    "apps/*"
  ],
  "devDependencies": {
    "@playwright/test": "1.60.0",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "jsdom": "27.4.0",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "vite": "7.3.1",
    "vitest": "4.0.18"
  }
}
